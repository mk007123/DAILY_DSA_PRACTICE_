class Solution {
    public boolean checkString(String str) {
        int n = str.length();
        int a = 0;
        int b = 0;
        for (int i = 0; i < n; i++) {
            char ch = str.charAt(i);
            if (ch == 'a') {
                if (b >= 1) {
                    return false;
                }
                a++;

            } else {
                b++;

            }
        }
        if ((a == 0 && b >= 1) || (a >= 1 && b == 0) || (a >= 1 && b >= 1)) {
            return true;
        }

        return false;
    }
}
