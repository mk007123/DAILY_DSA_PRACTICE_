class Solution {
    public int minChanges(String str) {

        int n = str.length();
        int ans = 0;

        for (int i = 0; i < n; i = i + 2) {

            char curr = str.charAt(i);
            char next = str.charAt(i + 1);

            if (curr != next) {
                ans++;
            }
        }

        return ans;
    }
}
