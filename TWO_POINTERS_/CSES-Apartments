#include <iostream>
#include <bits/stdc++.h>
using namespace std;
int f(int l,int m,int k,int arr1[],int arr2[]){
    int ans=0;
 
    sort(arr1, arr1 + l);
    sort(arr2, arr2 + m);
    int i =0;
    int j=0;
    while(i<l&&j<m){
        int ele1=arr1[i];  //l
 
        int ele2=arr2[j];   //m
        int start=ele1-k;
        int end=ele1+k;
        if(ele2<start){
            j++;
 
        }
        else if(ele2>=start&&ele2<=end){
            i++;
            j++;
            ans++;
 
        }
        else{
            i++;
 
 
        }
        
        
 
 
 
    }
    return ans;
 
    
}
 
int main()
{
    
    
        int n,m,k;
        cin >> n>>m>>k;
        
        int arr1[n];
        int arr2[m];
 
 
 
        for (int i = 0; i < n; i++){
            int ele;
            cin >> ele;
            arr1[i] = ele;
        }
        for(int i=0;i<m;i++){
            int ele;
            cin>>ele;
            arr2[i]=ele;
 
        }
 
        cout << f(n,m,k,arr1,arr2) << endl;
    
 
    return 0;
}
